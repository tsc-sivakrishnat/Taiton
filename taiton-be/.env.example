NODE_ENV=development
PORT=8787

# MariaDB / MySQL — keep pool small on shared hosting
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=enterprise_adm
DB_CONNECTION_LIMIT=5
DB_QUEUE_LIMIT=0

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

CORS_ORIGIN=https://cpanel-qzpv.onrender.com

# Email — Render blocks outbound SMTP (587/465): use Resend HTTPS API in production.
# 1) Sign up at resend.com, verify a domain (or use onboarding@resend.dev for tests).
# 2) RESEND_API_KEY=re_...
# 3) MAIL_FROM must match an allowed sender (e.g. onboarding@resend.dev or noreply@yourdomain.com)
RESEND_API_KEY=

# Local/dev optional SMTP (Gmail app password, etc.):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_DEV_TEAM=techtrole@gmail.com
APP_PUBLIC_URL=https://cpanel-qzpv.onrender.com
